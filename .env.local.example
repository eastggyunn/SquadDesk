# Supabase project connection.
# 1) 이 파일을 복사해 .env.local로 저장한다: cp .env.local.example .env.local
# 2) Supabase 프로젝트 설정 > API 에서 값을 채운다. 실제 값은 절대 커밋하지 않는다.
# 3) service_role 키는 여기에 절대 넣지 않는다 — 브라우저에 노출되는 NEXT_PUBLIC_* 변수에는
#    공개해도 안전한 anon(public) 키만 사용한다.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 회원가입 시 이메일 인증 링크가 돌아올 주소(/auth/callback). 로컬 개발 기본값은
# http://localhost:3000이며, 실제 배포 도메인이 생기면 그 값으로 바꾼다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- 알림 메일 요약 (app/api/cron/notification-digest) — 서버 전용, NEXT_PUBLIC_ 금지 ----
# Vercel Cron이 매일 00:00 UTC(오전 9시 KST)에 부른다. 하나라도 비면 메일은 건너뛴다.
# service_role 키: Supabase 프로젝트 설정 > API. 브라우저 코드에서 절대 쓰지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
# https://resend.com 에서 발급. 보내는 주소의 도메인을 Resend에서 인증해야 팀원에게 발송된다.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM="SquadDesk <notifications@example.com>"
# 임의의 긴 문자열. Vercel이 크론 요청에 Authorization: Bearer <값>을 붙인다.
CRON_SECRET=
